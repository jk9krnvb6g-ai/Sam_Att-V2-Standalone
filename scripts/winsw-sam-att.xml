<!--
  ============================================================================
  Sam_Att V2 Standalone — WinSW (Windows Service Wrapper) Configuration
  File: scripts/winsw-sam-att.xml (Deployed to D:\WebApps\Sam_Att\Service\SamAttV2Standalone.xml)
  ============================================================================
  Phase 2.6 Standard (Windows Server 2025 Standard Evaluation — 10.2.0.23):
  - Service ID       : SamAttV2Standalone
  - Display Name     : Sam_Att V2 Standalone
  - Startup Type     : Automatic (Delayed Start)
  - Working Directory: D:\WebApps\Sam_Att\App
  - External Config  : D:\WebApps\Sam_Att\Config\.env
  - Certs Directory  : D:\WebApps\Sam_Att\Certs
  - Logs Directory   : D:\WebApps\Sam_Att\Logs
  - Backups Directory: D:\Backups\Sam_Att
  - Deployments Dir  : D:\Deployments\Sam_Att
  - Isolation Policy : Strictly independent from IIS, Procurement, and other services.
                       Never uses taskkill /F /IM node.exe or iisreset.
-->
<service>
  <id>SamAttV2Standalone</id>
  <name>Sam_Att V2 Standalone</name>
  <description>Sam_Att V2 Standalone Hospital Attendance System</description>

  <!-- Working Directory of the Application -->
  <workingdirectory>D:\WebApps\Sam_Att\App</workingdirectory>

  <!-- Node.js Runtime Executable & Arguments -->
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>--import tsx D:\WebApps\Sam_Att\App\server.ts</arguments>

  <!-- Production Environment Variables -->
  <env name="NODE_ENV" value="production" />
  <env name="PORT" value="4101" />
  <env name="SAM_ATT_HTTPS_PORT" value="4101" />
  <env name="PUBLIC_BASE_PATH" value="/Sam_Att/" />
  <env name="API_BASE_PATH" value="/api/Sam_Att" />
  <env name="SAM_ATT_DATA_MODE" value="REAL" />
  <env name="SAM_ATT_DB_ENGINE" value="mysql" />
  <env name="SAM_ATT_ROOT" value="D:\WebApps\Sam_Att" />
  <env name="SAM_ATT_APP_DIR" value="D:\WebApps\Sam_Att\App" />
  <env name="SAM_ATT_CONFIG_DIR" value="D:\WebApps\Sam_Att\Config" />
  <env name="SAM_ATT_ENV_PATH" value="D:\WebApps\Sam_Att\Config\.env" />
  <env name="SAM_ATT_LOGS_DIR" value="D:\WebApps\Sam_Att\Logs" />
  <env name="SAM_ATT_SERVICE_DIR" value="D:\WebApps\Sam_Att\Service" />
  <env name="SAM_ATT_CERTS_DIR" value="D:\WebApps\Sam_Att\Certs" />
  <env name="TLS_CERT_PATH" value="D:\WebApps\Sam_Att\Certs\server.crt" />
  <env name="TLS_KEY_PATH" value="D:\WebApps\Sam_Att\Certs\server.key" />
  <env name="SAM_ATT_BACKUP_DIR" value="D:\Backups\Sam_Att" />
  <env name="SAM_ATT_DEPLOYMENTS_DIR" value="D:\Deployments\Sam_Att" />
  <env name="SCANNER_READER_EXE_PATH" value="D:\WebApps\Sam_Att\App\ScannerReader\ScannerSyncCli.exe" />
  <!-- Cutover Safety: Keep scheduler in Standby (false) on 10.2.0.23 until Cutover from 10.2.0.13 is approved -->
  <env name="SCANNER_AUTO_SCHEDULER_ENABLED" value="false" />

  <!-- Automatic Delayed Startup on Boot -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <!-- Least-Privilege Dedicated Service Account (NT AUTHORITY\NetworkService) -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>NetworkService</user>
  </serviceaccount>

  <!-- Automatic Failure Recovery Policy -->
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>

  <!-- Graceful Shutdown Timeout -->
  <stoptimeout>20 sec</stoptimeout>

  <!-- Rolling Service Logs in D:\WebApps\Sam_Att\Logs -->
  <logpath>D:\WebApps\Sam_Att\Logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <keepFiles>30</keepFiles>
  </log>
</service>
