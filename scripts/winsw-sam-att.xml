<!--
  ============================================================================
  Sam_Att V2 Standalone — WinSW (Windows Service Wrapper) Configuration
  File: scripts/winsw-sam-att.xml
  ============================================================================
  แก้ไขปัญหา P0 ข้อ 06:
  ใช้ WinSW เป็น Windows Service Wrapper มาตรฐานแทนการเรียก sc.exe ชี้ไปยัง node.exe โดยตรง
  กำหนด Working Directory, Environment Variables, Service Account, Restart Policy และ Rolling Logs
  โดยแยกอิสระจากระบบจัดซื้อจัดจ้าง (Procurement) และ Central API Gateway 100%
-->
<service>
  <id>SamAttV2Standalone</id>
  <name>Sam_Att V2 Standalone HTTPS Server (4101)</name>
  <description>ระบบบริหารเวลาปฏิบัติงานบุคลากร โรงพยาบาลสามชุก (Sam_Att V2 Standalone Single-Port HTTPS 4101)</description>

  <!-- พาธ Working Directory ของแอปพลิเคชัน -->
  <workingdirectory>C:\Sam_Att\app</workingdirectory>

  <!-- รันผ่าน Node.js v26.13.1 -->
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>--import tsx C:\Sam_Att\app\server.ts</arguments>

  <!-- กำหนด Environment Variables สำหรับ Production (ใบรับรอง TLS จัดเก็บนอก Repository) -->
  <env name="NODE_ENV" value="production" />
  <env name="PORT" value="4101" />
  <env name="SAM_ATT_HTTPS_PORT" value="4101" />
  <env name="PUBLIC_BASE_PATH" value="/Sam_Att/" />
  <env name="API_BASE_PATH" value="/api/Sam_Att" />
  <env name="SAM_ATT_DB_ENGINE" value="mysql" />
  <env name="TLS_CERT_PATH" value="C:\Sam_Att\certs\server.crt" />
  <env name="TLS_KEY_PATH" value="C:\Sam_Att\certs\server.key" />
  <env name="SAM_ATT_BACKUP_DIR" value="C:\Sam_Att\backups" />

  <!-- กำหนดการเริ่มทำงานอัตโนมัติเมื่อเปิดเครื่อง (Automatic Startup on Boot) -->
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <!-- บัญชี Service Account มาตรฐานที่มีสิทธิ์จำกัดเฉพาะโฟลเดอร์ C:\Sam_Att -->
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>NetworkService</user>
  </serviceaccount>

  <!-- นโยบายการกู้คืนอัตโนมัติเมื่อโปรเซสล่ม (Restart Policy) -->
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>

  <!-- การปิดโปรเซสอย่างปลอดภัย (Graceful Shutdown) -->
  <stoptimeout>15 sec</stoptimeout>

  <!-- กำหนดพาธจัดเก็บไฟล์ Log แบบหมุนเวียน (Rolling Logs) -->
  <logpath>C:\Sam_Att\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <keepFiles>30</keepFiles>
  </log>
</service>
