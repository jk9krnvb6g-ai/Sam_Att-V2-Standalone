# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# Sam_Att V2 Standalone — Core Server & Single-Port HTTPS Configuration
# Standard Production Layout (Windows Server 2025 — Drive D):
#   SAM_ATT_ROOT=D:\WebApps\Sam_Att
#   Config File : D:\WebApps\Sam_Att\Config\.env
#   App Folder  : D:\WebApps\Sam_Att\App
#   Logs Folder : D:\WebApps\Sam_Att\Logs
#   Certs Folder: D:\WebApps\Sam_Att\Certs
#   Backups     : D:\Backups\Sam_Att
#   Deployments : D:\Deployments\Sam_Att
# ============================================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=4101
SAM_ATT_HTTPS_PORT=4101
PUBLIC_BASE_PATH=/Sam_Att/
API_BASE_PATH=/api/Sam_Att

SAM_ATT_ROOT=D:\\WebApps\\Sam_Att
SAM_ATT_APP_DIR=D:\\WebApps\\Sam_Att\\App
SAM_ATT_CONFIG_DIR=D:\\WebApps\\Sam_Att\\Config
SAM_ATT_LOGS_DIR=D:\\WebApps\\Sam_Att\\Logs
SAM_ATT_SERVICE_DIR=D:\\WebApps\\Sam_Att\\Service
SAM_ATT_CERTS_DIR=D:\\WebApps\\Sam_Att\\Certs
SAM_ATT_BACKUP_DIR=D:\\Backups\\Sam_Att
SAM_ATT_DEPLOYMENTS_DIR=D:\\Deployments\\Sam_Att

# P0 Security Policy: Store Production TLS certificates in D:\WebApps\Sam_Att\Certs (outside Git Repository)
TLS_CERT_PATH=D:\\WebApps\\Sam_Att\\Certs\\server.crt
TLS_KEY_PATH=D:\\WebApps\\Sam_Att\\Certs\\server.key

# ============================================================================
# Sam_Att V2 Standalone — Data Mode & Primary MySQL 8+ Database (Isolated Schema)
# Set SAM_ATT_DATA_MODE=REAL in Production (Strict Real Hospital Data, Zero Mock/Demo Data)
# Set SAM_ATT_DATA_MODE=DEMO ONLY in local non-production sqlite_sandbox for training/demo
# Set SAM_ATT_DB_ENGINE=mysql in Production (Strict Fail-Closed, No Mock Fallback)
# Set SAM_ATT_DB_ENGINE=sqlite_sandbox ONLY for automated local test harness
# ============================================================================
SAM_ATT_DATA_MODE=REAL
SAM_ATT_DB_ENGINE=mysql
SAM_ATT_DB_HOST=10.1.0.201
SAM_ATT_DB_PORT=3306
SAM_ATT_DB_NAME=samchuk_attendance_v2
SAM_ATT_DB_USER=sam_att_app
SAM_ATT_DB_PASSWORD=CHANGE_ME
SAM_ATT_SQLITE_PATH=./data/sam_att_v2.sqlite

# ============================================================================
# HOSOffice Database Integration (Read-Only Source of Truth for hr_person,
# and Scoped Write Account for HOSOffice Live Push Target Table)
# ============================================================================
HOSOFFICE_DB_HOST=CHANGE_ME
HOSOFFICE_DB_PORT=3306
HOSOFFICE_DB_NAME=hosoffice
HOSOFFICE_DB_USER=hosoffice_readonly
HOSOFFICE_DB_PASSWORD=CHANGE_ME
HOSOFFICE_HR_PERSON_TABLE=hr_person
HOSOFFICE_PUSH_WRITE_USER=hosoffice_attendance_writer
HOSOFFICE_PUSH_WRITE_PASSWORD=CHANGE_ME

# ============================================================================
# Authentication & Session Security (P0 Policy: No Static Fallback in Production)
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================================
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_AT_DEPLOY
SESSION_TTL_MINUTES=480
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================================================
# Scanner Reader EXE (ScannerSyncCli.exe), Automatic Scheduler & Live Push Flags
# Cutover Safety Policy: Keep SCANNER_AUTO_SCHEDULER_ENABLED=false (Standby Mode)
# on new server 10.2.0.23 until old server 10.2.0.13 scheduler is stopped and Cutover is approved.
# ============================================================================
SCANNER_SYNC_ENABLED=false
SCANNER_AUTO_SCHEDULER_ENABLED=false
SCANNER_READER_EXE_PATH=D:\\WebApps\\Sam_Att\\App\\ScannerReader\\ScannerSyncCli.exe
# Bounded scanner EXE timeout (default 120000 ms, min 5000 ms, hard cap 300000 ms)
SCANNER_READER_TIMEOUT_MS=120000
# Bounded scanner EXE stdout/stderr maxBuffer in bytes (default 33554432 = 32 MB, min 1 MB, hard cap 64 MB)
SCANNER_READER_MAX_BUFFER_BYTES=33554432
SCANNER_SYNC_DAYS=3
SCANNER_SYNC_MAX_RANGE_DAYS=90
SCANNER_CLI_PREVIEW_MODE=true
SCANNER_INGEST_SHARED_TOKEN=GENERATE_SCANNER_INGEST_SECRET_AT_DEPLOY
HOSOFFICE_LIVE_PUSH_ENABLED=false
# Must be explicitly approved and set by hospital DBA before enabling HOSOFFICE_LIVE_PUSH_ENABLED=true
HOSOFFICE_PUSH_TARGET_TABLE=

# ============================================================================
# GitHub Update Center (Read-Only Version Checker & Changelog)
# Optional GITHUB_TOKEN avoids anonymous GitHub API rate limits (server-side only; never exposed to browser)
# ============================================================================
GITHUB_REPO=jk9krnvb6g-ai/Sam_Att-V2-Standalone
GITHUB_BRANCH=main
GITHUB_TOKEN=
GITHUB_API_TIMEOUT_MS=10000
# Default 1800000 ms (30 minutes) to cache version checks and protect GitHub API rate limits
GITHUB_CACHE_TTL_MS=1800000


