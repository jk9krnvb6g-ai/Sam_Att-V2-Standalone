# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# Sam_Att V2 Standalone — Core Server & Single-Port HTTPS Configuration
# ============================================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=4101
PUBLIC_BASE_PATH=/Sam_Att/
API_BASE_PATH=/api/Sam_Att

# P0 Security Policy: Store Production TLS certificates in C:\inetpub\wwwroot\Sam_Att\certs (ignored by Git via .gitignore)
TLS_CERT_PATH=C:\\inetpub\\wwwroot\\Sam_Att\\certs\\server.crt
TLS_KEY_PATH=C:\\inetpub\\wwwroot\\Sam_Att\\certs\\server.key

# ============================================================================
# Sam_Att V2 Standalone — Primary MySQL 8+ Database (Isolated Schema)
# Set SAM_ATT_DB_ENGINE=mysql in Production (Strict Fail-Closed, No Mock Fallback)
# Set SAM_ATT_DB_ENGINE=sqlite_sandbox ONLY for automated local test harness
# ============================================================================
SAM_ATT_DB_ENGINE=mysql
SAM_ATT_DB_HOST=127.0.0.1
SAM_ATT_DB_PORT=3306
SAM_ATT_DB_NAME=samchuk_attendance_v2
SAM_ATT_DB_USER=sam_att_app
SAM_ATT_DB_PASSWORD=CHANGE_ME
SAM_ATT_SQLITE_PATH=./data/sam_att_v2.sqlite

# ============================================================================
# HOSOffice Database Integration (Read-Only Source of Truth for hr_person,
# and Scoped Write Account for HOSOffice Live Push Target Table)
# ============================================================================
HOSOFFICE_DB_HOST=CHANGE_ME
HOSOFFICE_DB_PORT=3306
HOSOFFICE_DB_NAME=hosoffice
HOSOFFICE_DB_USER=hosoffice_readonly
HOSOFFICE_DB_PASSWORD=CHANGE_ME
HOSOFFICE_HR_PERSON_TABLE=hr_person
HOSOFFICE_PUSH_WRITE_USER=hosoffice_attendance_writer
HOSOFFICE_PUSH_WRITE_PASSWORD=CHANGE_ME

# ============================================================================
# Authentication & Session Security (P0 Policy: No Static Fallback in Production)
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================================
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_AT_DEPLOY
SESSION_TTL_MINUTES=480
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================================================
# Scanner Reader EXE (ScannerSyncCli.exe), Automatic Scheduler & Live Push Flags
# ============================================================================
SCANNER_SYNC_ENABLED=false
SCANNER_AUTO_SCHEDULER_ENABLED=true
SCANNER_READER_EXE_PATH=./ScannerReader/ScannerSyncCli.exe
SCANNER_READER_TIMEOUT_MS=30000
SCANNER_SYNC_DAYS=3
SCANNER_CLI_PREVIEW_MODE=true
SCANNER_INGEST_SHARED_TOKEN=GENERATE_SCANNER_INGEST_SECRET_AT_DEPLOY
HOSOFFICE_LIVE_PUSH_ENABLED=false
# Must be explicitly approved and set by hospital DBA before enabling HOSOFFICE_LIVE_PUSH_ENABLED=true
HOSOFFICE_PUSH_TARGET_TABLE=

